{
  "ignoreCommand": "if git cat-file -e \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}^{commit}\" 2>/dev/null; then git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD ./; else exit 1; fi",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/perfil.html",
      "destination": "/perfil",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/publicaciones.html",
      "destination": "/publicaciones",
      "permanent": true
    },
    {
      "source": "/cv.html",
      "destination": "/cv",
      "permanent": true
    }
  ]
}
